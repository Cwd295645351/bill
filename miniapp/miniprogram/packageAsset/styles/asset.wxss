.page .tag { margin-left: 8rpx; padding: 0 8rpx; font-size: 20rpx; line-height: 32rpx; border-radius: 6rpx; }
.page .tag.ok { color: #18a356; background: #e8f7ee; }
.page .tag.warn { color: #e6862e; background: #fdf0e6; }
