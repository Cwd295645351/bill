.page .a-legend b { margin-left: auto; color: #333; font-weight: 600; }
.page .a-year { display: inline-block; height: 56rpx; padding: 0 20rpx; color: #333; font-size: 26rpx; line-height: 52rpx; background: #f7f8fa; border: 2rpx solid #e5e6eb; border-radius: 16rpx; }
