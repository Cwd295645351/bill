# OpenAI Chat Completions 兼容服务的 API Key
AI_API_KEY=

# 以下配置可选，默认使用硅基流动及 DeepSeek V3.2
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_MODEL=Pro/deepseek-ai/DeepSeek-V3.2

# 微信小程序（个人主体）。用于 code 换 openid，禁止提交真实密钥
WX_APPID=
WX_SECRET=

# 登录令牌签名密钥。修改后已登录用户需要重新登录
JWT_SECRET=

# 密码哈希盐。修改后已有账号无法用原密码登录，需要重置密码
PASSWORD_SALT=

# 账本邀请码对称加密，必须各为 16 字节。修改后未过期的邀请码会失效
AES_KEY=
AES_IV=

# 允许调用「更新登录 RSA 密钥」接口的登录用户名。留空则该接口拒绝所有请求
ADMIN_USERNAME=

# MySQL 账号密码必填。主机、端口、库名不填时分别为 127.0.0.1、3306、bill
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bill

# Redis 不填时为 127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 阿里云对象存储（记账照片）。只放服务端，禁止提交真实密钥，不要写入小程序或电脑端源码
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 短期查看地址签名密钥，与对象存储密钥分开；只放服务端
OSS_URL_SECRET=
