<view class="page">
  <view class="title">{{ mode === 'register' ? '注册新账号' : '绑定已有账号' }}</view>
  <view class="desc">
    <block wx:if="{{ mode === 'register' }}">注册成功后将自动绑定当前微信并进入小程序，之后可静默登录。</block>
    <block wx:else>使用已有账号密码完成一次性绑定；也可切换到注册新账号。</block>
  </view>
  <van-cell-group>
    <van-field label="账号" value="{{ username }}" placeholder="{{ mode === 'register' ? '英文与数字，3～20 位' : '请输入账号' }}" bind:change="onUsername" />
    <van-field wx:if="{{ mode === 'register' }}" label="昵称" value="{{ nickName }}" placeholder="选填，默认与账号相同" bind:change="onNickName" />
    <van-field label="密码" type="password" value="{{ password }}" placeholder="{{ mode === 'register' ? '至少 8 位，含大小写与数字' : '请输入密码' }}" bind:change="onPassword" />
  </van-cell-group>
  <view class="switch">
    <text wx:if="{{ mode === 'register' }}" class="switch-muted">已有账号？</text>
    <text wx:else class="switch-muted">还没有账号？</text>
    <text class="switch-link" bindtap="onToggleMode">{{ mode === 'register' ? '去绑定' : '注册新账号' }}</text>
  </view>
  <view class="btn">
    <van-button type="primary" block round color="#4285F4" loading="{{ submitting }}" bind:click="onSubmit">
      {{ mode === 'register' ? '注册并进入' : '绑定并进入' }}
    </van-button>
  </view>

  <van-popup show="{{ captchaVisible }}" round position="center" custom-style="width: 92%; max-width: 360px; padding: 16px 12px 12px;" bind:close="onCaptchaClose" closeable>
    <view class="captcha-title">安全验证</view>
    <slider-captcha wx:if="{{ captchaVisible }}" id="slider" bind:update="onCaptchaUpdate" />
  </van-popup>
</view>
