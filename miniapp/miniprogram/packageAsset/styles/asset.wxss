.page .a-ledger .a-note { margin-top: 16rpx; color: #c0c4cc; font-size: 22rpx; }
.page .empty { padding: 144rpx 48rpx 48rpx; color: #969799; font-size: 28rpx; text-align: center; }
.page .empty .illus { width: 240rpx; height: 192rpx; margin: 0 auto 32rpx; background: radial-gradient(circle at 50% 42%, #d9dde3 0 56rpx, transparent 58rpx), linear-gradient(#e6e8ec, #e6e8ec) 56rpx 140rpx / 128rpx 16rpx no-repeat; }
.page .panel { margin: 24rpx; overflow: hidden; background: #fff; border-radius: 16rpx; }
.page .field { display: flex; align-items: center; min-height: 96rpx; padding: 0 32rpx; background: #fff; border-bottom: 2rpx solid #f2f3f5; font-size: 32rpx; }
