.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f5f6f8;
  box-sizing: border-box;
  /* 给 fixed 的 book-tab-bar 让位（100rpx 按钮行 + 安全区） */
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}
.budget-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.budget-head {
  flex: none;
}
.budget-list {
  flex: 1;
  min-height: 0;
  height: 0;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}
.a-hero {
  margin: 8rpx 24rpx 20rpx;
  padding: 32rpx 32rpx 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #3b78e7, #6aa6ff);
  border-radius: 24rpx;
}
.a-hero .label {
  font-size: 24rpx;
  opacity: 0.85;
}
.a-hero .split {
  display: flex;
  margin-top: 24rpx;
}
.a-hero .split > view {
  flex: 1;
}
.a-hero .k {
  font-size: 24rpx;
  opacity: 0.8;
}
.a-hero .v {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.a-fx {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.4;
  opacity: 0.85;
}
.a-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
}
.pie-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.a-note {
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.a-pie {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.a-disk {
  width: 216rpx;
  height: 216rpx;
  flex: none;
}
.a-disk-placeholder {
  border-radius: 50%;
  background: #f2f3f5;
}
.a-legend {
  flex: 1;
  min-width: 0;
}
.legend-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 6rpx 0;
  color: #666;
  font-size: 24rpx;
}
.legend-row .dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
  flex: none;
}
.legend-row .name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.legend-row .pct,
.legend-row .amt {
  margin-left: 16rpx;
  color: #333;
  font-weight: 600;
  flex: none;
}
.b-card {
  box-sizing: border-box;
  width: calc(100% - 48rpx);
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: left;
}
.a-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  text-align: left;
}
.type {
  flex: none;
  font-size: 30rpx;
  font-weight: 600;
  text-align: left;
}
.a-note {
  margin: 0;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.b-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.cost {
  color: #f74f4f;
}
.b-line {
  height: 16rpx;
  margin: 12rpx 0 20rpx;
  overflow: hidden;
  background: #f2f3f5;
  border-radius: 8rpx;
}
.fill {
  height: 100%;
  border-radius: 8rpx;
}
.b-ops {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.b-ops button {
  flex: 1;
  max-width: 176rpx;
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  border: none;
}
.b-ops .edit {
  color: #4285f4;
  background: #e8f1ff;
}
.b-ops .del {
  width: auto;
  min-width: 0;
  color: #f74f4f;
  background: #fdecec;
}
.a-foot {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.a-foot .primary {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  color: #fff;
  font-size: 28rpx;
  background: #4285f4;
  border-radius: 40rpx;
  border: none;
}
.sheet-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.sheet-title {
  font-weight: 600;
}
.cancel {
  color: #999;
}
.confirm {
  color: #4285f4;
}
.hint {
  padding: 16rpx 32rpx 32rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.sheet-side {
  width: 64rpx;
}
.type-list {
  background: #fff;
}
.type-item {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #323233;
  border-bottom: 2rpx solid #ebedf0;
}
.type-item.on {
  color: #4285f4;
  font-weight: 600;
}
.type-item-hover {
  background: #f2f3f5;
}
