{
  
  "apps" : [{
    "name": "bill-manage",
    "script": "dist/server.js",
    "instances": 1,
    "cwd": "./",
    "ignore_watch": [
      "logs"
    ],
    "autorestart": true,
    "watch": true,
    "max_memory_restart": "500M",
    "err_file": "logs/err.log",
    "out_file": "logs/out.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss",
    "exec_interpreter": "node",
    "env": {
      "NODE_ENV": "production"
    },
    "env_dev": {
      "NODE_ENV": "development"
    },
    "env_pred": {
      "NODE_ENV": "pred"
    },
    "env_prod": {
      "NODE_ENV": "production"
    }
  }]
}