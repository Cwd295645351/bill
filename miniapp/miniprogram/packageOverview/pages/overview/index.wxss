.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}
.body {
  flex: 1;
  min-height: 0;
}
.card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
}
.dims,
.stepper,
.range,
.members,
.sheet-bar,
.row-top {
  display: flex;
  align-items: center;
}
.dims,
.stepper,
.members,
.months,
.years {
  gap: 16rpx;
}
.dim,
.stepper view,
.chip,
.months view,
.years view {
  flex: 1;
  text-align: center;
  background: #f3f5f8;
  border-radius: 16rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
}
.dim.on,
.chip.on {
  background: #4285f4;
  color: #fff;
}
.stepper {
  margin-top: 20rpx;
}
.stepper .center {
  background: #fff;
  font-weight: 600;
}
.range {
  margin-top: 20rpx;
  gap: 16rpx;
}
.range picker {
  flex: 1;
}
.date {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #222;
}
.to {
  color: #888;
}
.sums {
  display: flex;
  flex-wrap: wrap;
}
.sums > view {
  width: 50%;
  box-sizing: border-box;
  padding: 12rpx 0;
}
.sums text,
.title {
  display: block;
  color: #888;
  font-size: 24rpx;
}
.num,
.name,
.line,
.income text,
.record text,
.legend-item text {
  word-break: break-all;
}
.num {
  color: #222;
  font-size: 32rpx;
  font-weight: 600;
}
.num.out {
  color: #f74f4f;
}
.num.in {
  color: #18a356;
}
.struct .title {
  margin-bottom: 32rpx;
}
.income,
.line {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #222;
}
.cumulative-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #dcdfe6;
  position: relative;
  flex: none;
}
.switch.on {
  background: #4285f4;
}
.switch.disabled {
  opacity: 0.45;
}
.switch .knob {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
}
.switch.on .knob {
  left: 40rpx;
}
.note {
  margin-top: 16rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 40rpx;
}
.income {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}
.members {
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.chip {
  flex: none;
  padding: 12rpx 20rpx;
}
.chart {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}
.donut {
  position: relative;
  width: 336rpx;
  height: 336rpx;
}
.wedge {
  position: absolute;
  inset: 0;
}
.hole {
  position: absolute;
  left: 72rpx;
  top: 72rpx;
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: #fff;
}
.legend {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.legend-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx 8rpx 12rpx 0;
  min-width: 0;
}
.legend-item .dot {
  margin-top: 6rpx;
}
.legend-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.legend-item .name {
  font-size: 24rpx;
  line-height: 1.3;
}
.legend-item .pct {
  color: #888;
  font-size: 24rpx;
  line-height: 1.3;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-top {
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}
.row-top .num {
  margin-left: auto;
  font-size: 28rpx;
}
.meta,
.muted {
  color: #888;
  font-size: 24rpx;
}
.muted {
  margin: 16rpx 24rpx;
}
.muted.inner {
  margin: 16rpx 0;
}
.bar {
  height: 12rpx;
  margin-top: 12rpx;
  background: #f0f2f5;
  border-radius: 198rpx;
  overflow: hidden;
}
.bar view {
  height: 12rpx;
}
.chev {
  color: #bbb;
  font-size: 36rpx;
}
.sheet {
  padding: 24rpx 24rpx 48rpx;
  max-height: 70vh;
  overflow: auto;
}
.records-sheet {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0;
  max-height: 70vh;
}
.records-sheet .sheet-bar {
  position: relative;
  flex: none;
  margin-bottom: 0;
  padding: 28rpx 24rpx 20rpx;
  background: #fff;
}
.sheet-body {
  height: 56vh;
  box-sizing: border-box;
  padding: 0 24rpx 32rpx;
}
.sheet-bar {
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-weight: 600;
  color: #4285f4;
}
.sheet-bar text {
  color: #222;
}
.sheet-title {
  position: absolute;
  left: 144rpx;
  right: 144rpx;
  text-align: center;
}
.months,
.years {
  display: flex;
  flex-wrap: wrap;
}
.months view,
.years view {
  width: 30%;
  flex: none;
  margin-bottom: 16rpx;
}
.record {
  padding: 20rpx 0;
  border-top: 2rpx solid #f2f3f5;
}
.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.record-top .num {
  flex: none;
  margin-left: 24rpx;
  text-align: right;
}
