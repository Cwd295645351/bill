.page .sheet-bar { display: flex; align-items: center; justify-content: space-between; height: 88rpx; padding: 0 32rpx; border-bottom: 2rpx solid #f2f3f5; }
.page .sheet-bar .cancel { color: #969799; }
.page .sheet-bar .confirm { color: #4285f4; }
.page .sheet-title { font-size: 30rpx; font-weight: 600; }
