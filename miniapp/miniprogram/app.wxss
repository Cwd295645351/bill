page {
  height: 100%;
  background: #f5f6f8;
  color: #333;
  font-size: 28rpx;
  box-sizing: border-box;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1.4;
}

button::after {
  border: none;
}

.cost {
  color: #f74f4f;
}

.income {
  color: #18a356;
}
