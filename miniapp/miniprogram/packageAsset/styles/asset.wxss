.page .a-check { display: inline-flex; align-items: center; gap: 12rpx; height: 56rpx; color: #666; font-size: 26rpx; }
.page .a-check i { display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; color: #fff; font-size: 24rpx; font-style: normal; border: 2rpx solid #c9cdd4; border-radius: 8rpx; background: #fff; }
.page .a-check.on i { border-color: #4285f4; background: #4285f4; }
.page .a-line { display: block; width: 100%; height: 336rpx; margin-top: 16rpx; }
.page .a-pie { display: flex; align-items: center; gap: 24rpx; }
.page .a-disk { width: 216rpx; height: 216rpx; flex: none; border-radius: 50%; }
.page .a-legend { flex: 1; min-width: 0; }
