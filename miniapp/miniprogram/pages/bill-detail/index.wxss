.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.summary-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  margin-bottom: 20rpx;
}

.invite {
  height: 56rpx;
  margin-right: 12rpx;
  padding: 0 20rpx;
  color: #4285f4;
  font-size: 24rpx;
  line-height: 56rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
}

.search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #4285f4;
  box-shadow: 0 8rpx 24rpx rgba(66, 133, 244, 0.4);
}

.summary {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 24rpx;
  padding: 20rpx 24rpx 24rpx;
  border-radius: 16rpx;
  color: #333;
  background: linear-gradient(135deg, #dcf8f9, #8eb6f8);
}

.item {
  width: 33.33%;
  margin-top: 8rpx;
}

.label {
  color: #5f6b7a;
  font-size: 24rpx;
}

.num {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.types {
  display: flex;
  margin: 0 24rpx 12rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.type {
  flex: 1;
  text-align: center;
  line-height: 72rpx;
  color: #999;
}

.type.on {
  color: #4285f4;
  font-weight: 600;
}

.list {
  flex: 1;
  height: 0;
}

.day {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  color: #666;
  font-size: 24rpx;
}

.sum .cost,
.money.cost {
  color: #f74f4f;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.row.mine {
  box-shadow: inset 6rpx 0 0 #4285f4;
}

.title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.mine-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 0 10rpx;
  color: #4285f4;
  font-size: 20rpx;
  line-height: 32rpx;
  background: #e8f0fe;
  border-radius: 8rpx;
}

.remark {
  margin-top: 6rpx;
  color: #999;
  font-size: 24rpx;
}

.money {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.del {
  width: 72px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  color: #fff;
  background: #f74f4f;
  border-radius: 12rpx;
}

.more {
  padding: 24rpx 24rpx 160rpx;
  text-align: center;
  color: #999;
}
