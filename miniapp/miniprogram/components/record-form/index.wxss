.form {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.body {
  flex: 1;
  height: 0;
}

.type-switch {
  display: flex;
  width: 280rpx;
  margin: 20rpx auto 0;
  border-radius: 32rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.type {
  flex: 1;
  text-align: center;
  line-height: 64rpx;
  color: #999;
}

.type.on {
  background: #fff;
  font-weight: 600;
}

.amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: fit-content;
  margin: 0 auto;
  padding: 24rpx 12rpx 8rpx;
  font-size: 72rpx;
  font-weight: 600;
  border-bottom: 4rpx solid transparent;
}

.amount.editing {
  border-bottom-color: currentColor;
}

.yen {
  margin-right: 8rpx;
  font-size: 40rpx;
}

.suggest {
  padding: 8rpx 24rpx 0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  color: #666;
  font-size: 26rpx;
  background: #f3f4f6;
}

.chip.on {
  color: #4285f4;
  background: #e8f1ff;
}

.chip.tool {
  min-width: 64rpx;
  text-align: center;
  color: #999;
}

.desc-box {
  position: relative;
  margin: 8rpx 0 16rpx;
}

.desc {
  width: 100%;
  height: 140rpx;
  padding: 8rpx 0 36rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.count {
  position: absolute;
  right: 0;
  bottom: 0;
  color: #bbb;
  font-size: 22rpx;
}

.shortcuts {
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.danger {
  margin: 24rpx;
  text-align: center;
  color: #f74f4f;
  line-height: 80rpx;
}

.submit-bar {
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.submit-bar .again,
.submit-bar .ok {
  flex: 1;
  height: 88rpx;
  margin: 0 8rpx;
  border-radius: 12rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
}

.submit-bar .again {
  color: #4285f4;
  background: #e8f1ff;
}

.submit-bar .ok {
  color: #fff;
  background: #4285f4;
}

.again-hover {
  background: #d7e6ff;
}

.ok-hover {
  background: #2f6fda;
}
