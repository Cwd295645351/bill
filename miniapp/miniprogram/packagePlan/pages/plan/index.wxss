.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f5f6f8;
  box-sizing: border-box;
  /* 给 fixed 的 book-tab-bar 让位（与预算页一致） */
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}
.plan-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.plan-head {
  flex: none;
}
.a-hint {
  margin: 16rpx 24rpx 20rpx;
  padding: 20rpx 24rpx;
  color: #666;
  font-size: 24rpx;
  line-height: 1.5;
  background: #fff;
  border-radius: 16rpx;
}
.plan-list {
  flex: 1;
  min-height: 0;
  height: 0;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}
.p-head {
  margin: 0 24rpx 16rpx;
  padding: 16rpx 24rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
}
.p-card {
  box-sizing: border-box;
  width: calc(100% - 48rpx);
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
}
.p-card .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.p-card .context {
  margin-top: 12rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}
.a-note {
  margin: 0 24rpx 20rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.b-ops {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.b-ops .edit,
.b-ops .del {
  flex: 1;
  max-width: 176rpx;
  margin: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  border: none;
}
.b-ops .edit {
  color: #4285f4;
  background: #e8f1ff;
}
.b-ops .del {
  color: #f74f4f;
  background: #fdecec;
}
.a-foot {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.a-foot .primary {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  color: #fff;
  font-size: 28rpx;
  background: #4285f4;
  border-radius: 40rpx;
  border: none;
}
.sheet {
  padding-bottom: 32rpx;
}
.sheet-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}
.sheet-title {
  font-weight: 600;
}
.cancel,
.confirm {
  color: #4285f4;
  font-size: 30rpx;
}
.cancel {
  color: #999;
}
.hint {
  padding: 16rpx 32rpx 0;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.chips {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx 8rpx;
}
.chip {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 2rpx solid #ebedf0;
  border-radius: 32rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
}
.chip.on {
  color: #fff;
  background: #4285f4;
  border-color: #4285f4;
}
.dialog-msg {
  padding: 16rpx 48rpx 40rpx;
  color: #666;
  font-size: 28rpx;
}
