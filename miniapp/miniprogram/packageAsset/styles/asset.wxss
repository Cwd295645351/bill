.page .a-result .title { display: block; margin-bottom: 8rpx; font-size: 36rpx; }
.page .a-scheme { display: flex; flex-direction: column; align-items: flex-start; gap: 16rpx; }
.page .a-scheme-row { display: flex; align-items: center; gap: 16rpx; }
.page .a-scheme-row > span { width: 52rpx; color: #666; font-size: 26rpx; }
