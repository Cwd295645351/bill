.header {
  display: flex;
  align-items: center;
  height: 240rpx;
  padding: 0 40rpx;
  color: #fff;
  background: #7baeff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #4285f4;
  text-align: center;
  line-height: 120rpx;
  font-size: 48rpx;
}

.name {
  margin-left: 24rpx;
  font-size: 40rpx;
}

.panel {
  margin: 24rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.relogin {
  padding: 24rpx;
}
