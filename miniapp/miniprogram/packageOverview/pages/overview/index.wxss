.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
  padding-bottom: calc(50px + constant(safe-area-inset-bottom));
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
}
.body {
  flex: 1;
  min-height: 0;
}
.card {
  margin: 12px;
  padding: 12px;
  background: #fff;
  border-radius: 12px;
}
.dims,
.stepper,
.range,
.members,
.sheet-bar,
.row-top {
  display: flex;
  align-items: center;
}
.dims,
.stepper,
.members,
.months,
.years {
  gap: 8px;
}
.dim,
.stepper view,
.chip,
.months view,
.years view {
  flex: 1;
  text-align: center;
  background: #f3f5f8;
  border-radius: 8px;
  padding: 8px 0;
  font-size: 14px;
  color: #333;
}
.dim.on,
.chip.on {
  background: #4285f4;
  color: #fff;
}
.stepper {
  margin-top: 10px;
}
.stepper .center {
  background: #fff;
  font-weight: 600;
}
.range {
  margin-top: 10px;
  gap: 8px;
}
.range picker {
  flex: 1;
}
.date {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  color: #222;
}
.to {
  color: #888;
}
.sums {
  display: flex;
  flex-wrap: wrap;
}
.sums > view {
  width: 50%;
  box-sizing: border-box;
  padding: 6px 0;
}
.sums text,
.title {
  display: block;
  color: #888;
  font-size: 12px;
}
.num,
.name,
.line,
.income text,
.record text,
.legend-item text {
  word-break: break-all;
}
.num {
  color: #222;
  font-size: 16px;
  font-weight: 600;
}
.num.out {
  color: #f74f4f;
}
.num.in {
  color: #18a356;
}
.struct .title {
  margin-bottom: 16px;
}
.income,
.line {
  margin-top: 8px;
  font-size: 14px;
  color: #222;
}
.income {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}
.members {
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.chip {
  flex: none;
  padding: 6px 10px;
}
.chart {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}
.donut {
  position: relative;
  width: 168px;
  height: 168px;
}
.wedge {
  position: absolute;
  inset: 0;
}
.hole {
  position: absolute;
  left: 36px;
  top: 36px;
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: #fff;
}
.legend {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.legend-item {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  width: 33.33%;
  box-sizing: border-box;
  padding: 6px 4px 6px 0;
  min-width: 0;
}
.legend-item .dot {
  margin-top: 3px;
}
.legend-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.legend-item .name {
  font-size: 12px;
  line-height: 1.3;
}
.legend-item .pct {
  color: #888;
  font-size: 12px;
  line-height: 1.3;
}
.row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex: none;
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-top {
  flex-wrap: wrap;
  gap: 6px 8px;
}
.row-top .num {
  margin-left: auto;
  font-size: 14px;
}
.meta,
.muted {
  color: #888;
  font-size: 12px;
}
.muted {
  margin: 8px 12px;
}
.muted.inner {
  margin: 8px 0;
}
.bar {
  height: 6px;
  margin-top: 6px;
  background: #f0f2f5;
  border-radius: 99px;
  overflow: hidden;
}
.bar view {
  height: 6px;
}
.chev {
  color: #bbb;
  font-size: 18px;
}
.sheet {
  padding: 12px 12px 24px;
  max-height: 70vh;
  overflow: auto;
}
.records-sheet {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0;
  max-height: 70vh;
}
.records-sheet .sheet-bar {
  position: relative;
  flex: none;
  margin-bottom: 0;
  padding: 14px 12px 10px;
  background: #fff;
}
.sheet-body {
  height: 56vh;
  box-sizing: border-box;
  padding: 0 12px 16px;
}
.sheet-bar {
  justify-content: space-between;
  margin-bottom: 12px;
  font-weight: 600;
  color: #4285f4;
}
.sheet-bar text {
  color: #222;
}
.sheet-title {
  position: absolute;
  left: 72px;
  right: 72px;
  text-align: center;
}
.months,
.years {
  display: flex;
  flex-wrap: wrap;
}
.months view,
.years view {
  width: 30%;
  flex: none;
  margin-bottom: 8px;
}
.record {
  padding: 10px 0;
  border-top: 1px solid #f2f3f5;
}
.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.record-top .num {
  flex: none;
  margin-left: 12px;
  text-align: right;
}
