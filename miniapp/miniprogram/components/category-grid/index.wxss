.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 12rpx 20rpx;
}

.item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  color: #fff;
  text-align: center;
  line-height: 84rpx;
  font-size: 32rpx;
}

.item.on .icon {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 8rpx #4285f4;
}

.name {
  margin-top: 8rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: #666;
}

.item.on .name {
  color: #4285f4;
}
