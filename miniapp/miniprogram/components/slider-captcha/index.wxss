.sc { margin: 32rpx 0; }
.sc__bg { position: relative; width: 100%; overflow: hidden; border-radius: 16rpx; background: #f2f3f5; }
.sc__bg-img { width: 100%; height: 100%; display: block; }
.sc__puzzle { position: absolute; pointer-events: none; }
.sc__refresh {
  position: absolute; top: 12rpx; right: 12rpx; width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0,0,0,.45); color: #fff; text-align: center; line-height: 56rpx; font-size: 28rpx;
}
.sc__track {
  position: relative; margin-top: 20rpx; height: 80rpx; border-radius: 40rpx;
  background: #f2f3f5; border: 2rpx solid #ebedf0; overflow: hidden;
}
.sc__fill { position: absolute; left: 0; top: 0; bottom: 0; background: rgba(66,133,244,.2); }
.sc__knob {
  position: absolute; top: 4rpx; width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #4285f4; color: #fff; text-align: center; line-height: 72rpx; font-size: 28rpx;
}
.sc__knob.fail {
  background: #ee0a24;
  color: #fff;
}
.sc__knob.ok { background: #07c160; }
.sc__hint {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  color: #969799; font-size: 26rpx; pointer-events: none;
}
.sc__error { margin-top: 16rpx; color: #ee0a24; font-size: 24rpx; }
